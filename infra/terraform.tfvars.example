# Copy this file to terraform.tfvars and adapt the values.
# terraform.tfvars is ignored by git.

aws_region        = "eu-west-3"
project_name      = "cigacount"
github_repository = "Selimo17/CigaCount-03-Sp-DevOps-3-AWS-"
github_branch     = "main"

# Receives the alarms and the budget alerts (confirm the subscription e-mail).
# The default setup costs about 40-45 USD a month: a 50 USD budget only
# alerts on an unexpected cost increase.
alert_email        = "you@example.com"
monthly_budget_usd = 50

# Set to false if a GitHub OIDC provider already exists in the AWS account.
create_github_oidc_provider = true

# Production options (extra cost):
# enable_nat_gateway = true
# certificate_arn    = "arn:aws:acm:eu-west-3:123456789012:certificate/..."
# desired_count      = 2
# min_capacity       = 2
